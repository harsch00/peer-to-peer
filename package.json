{
  "name": "p2pmesh",
  "version": "1.0.0",
  "private": true,
  "description": "p2p-mesh — Decentralized, serverless P2P mesh messenger built on a Bitchat-style Noise/BLE/Nostr stack.",
  "scripts": {
    "android": "react-native run-android",
    "windows": "set _CL_=/FS&& npx @react-native-community/cli run-windows --buildLogDirectory windows\\\\buildlogs --singleproc",
    "start": "react-native start",
    "lint": "eslint . --ext .ts,.tsx",
    "test": "jest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@noble/ciphers": "^1.0.0",
    "@noble/curves": "^1.6.0",
    "@noble/hashes": "^1.5.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^6.6.1",
    "@react-navigation/native": "^6.1.18",
    "@react-navigation/stack": "^6.4.1",
    "react": "18.3.1",
    "react-native": "0.76.5",
    "react-native-ble-plx": "3.5.1",
    "react-native-gesture-handler": "2.20.2",
    "react-native-get-random-values": "^1.11.0",
    "react-native-haptic-feedback": "2.3.4",
    "react-native-reanimated": "3.16.7",
    "react-native-safe-area-context": "4.14.1",
    "react-native-screens": "3.34.0",
    "react-native-svg": "15.15.4",
    "react-native-windows": "0.76.5",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native/babel-preset": "0.76.5",
    "@react-native/eslint-config": "0.76.5",
    "@react-native/metro-config": "0.76.5",
    "@react-native/typescript-config": "0.76.5",
    "@types/jest": "^29.5.13",
    "@types/react": "^18.3.12",
    "@types/react-test-renderer": "^18.3.0",
    "babel-jest": "^29.6.3",
    "babel-plugin-module-resolver": "^5.0.2",
    "eslint": "^8.57.1",
    "jest": "^29.6.3",
    "metro-config": "^0.81.5",
    "prettier": "2.8.8",
    "react-test-renderer": "18.3.1",
    "typescript": "5.0.4"
  },
  "engines": {
    "node": ">=18"
  },
  "jest": {
    "preset": "react-native"
  },
  "react-native-windows": {
    "init-windows": {
      "name": "p2pmesh",
      "namespace": "p2pmesh",
      "template": "old/uwp-cpp-app"
    }
  }
}
